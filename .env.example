# =============================================================================
#  MẪU CẤU HÌNH API — HƯỚNG DẪN DÙNG
# =============================================================================
#  1. Copy file này, đổi tên bản copy thành đúng ".env" (không có .example)
#  2. Điền API key vào bản .env đó
#  3. KHÔNG bao giờ sửa key vào file .env.example này
#
#  File .env đã bị chặn trong .gitignore nên key của bạn không lên GitHub.
#  File .env.example thì ĐƯỢC đẩy lên (vì nó rỗng, chỉ để làm mẫu).
# =============================================================================


# -----------------------------------------------------------------------------
# 1. CHỌN NHÀ CUNG CẤP AI
# -----------------------------------------------------------------------------
# Đổi đúng một dòng này là chuyển toàn bộ công cụ sang AI khác.
#   gemini  = Google Gemini, CÓ GÓI MIỄN PHÍ, không cần thẻ tín dụng
#   openai  = OpenAI, trả phí theo lượng dùng
#   claude  = Anthropic Claude, trả tiền, chất lượng văn phong tốt hơn
NHA_CUNG_CAP=gemini


# -----------------------------------------------------------------------------
# 2. GOOGLE GEMINI (miễn phí)
# -----------------------------------------------------------------------------
# Lấy key tại: https://aistudio.google.com  ->  Get API key
# Key có dạng: AIzaSy...
GEMINI_API_KEY=

# Tên model. Nếu chạy báo lỗi "không tìm thấy model", công cụ sẽ tự in ra
# danh sách model tài khoản bạn đang dùng được — copy một cái vào đây.
GEMINI_MODEL=gemini-3.7-flash


# -----------------------------------------------------------------------------
# 3. OPENAI (trả phí — chỉ cần khi NHA_CUNG_CAP=openai)
# -----------------------------------------------------------------------------
# Lấy key tại: https://platform.openai.com/api-keys
# Key có dạng: sk-...
# Cần nạp số dư trước, không có gói miễn phí.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5


# -----------------------------------------------------------------------------
# 4. ANTHROPIC CLAUDE (trả tiền — chỉ cần khi NHA_CUNG_CAP=claude)
# -----------------------------------------------------------------------------
# Lấy key tại: https://console.anthropic.com
# Key có dạng: sk-ant-...
ANTHROPIC_API_KEY=

# claude-opus-5    : mạnh nhất, ~2.800đ/bài
# claude-sonnet-5  : rẻ hơn ~40%, chất lượng vẫn tốt
# claude-haiku-4-5 : rẻ nhất, hợp bài ngắn
CLAUDE_MODEL=claude-opus-5


# -----------------------------------------------------------------------------
# 5. THÔNG SỐ CHUNG
# -----------------------------------------------------------------------------
# Độ dài tối đa của bài viết, tính bằng token.
# Ước lượng cho tiếng Việt: 1.500 từ ~ 4.000 token. Để dư ra cho an toàn.
MAX_TOKENS=24000

# Thời gian chờ tối đa mỗi lần gọi API (giây). Bài dài cần nhiều thời gian.
TIMEOUT=420

# Mức "suy nghĩ" — CHỈ ÁP DỤNG CHO OPENAI dòng gpt-5.
# Trước khi viết chữ đầu tiên, model bỏ ra một lượng token để tự nghĩ. Bạn không
# đọc được chúng nhưng vẫn phải chờ và vẫn phải trả tiền. Sau mỗi bài, công cụ
# ghi ra log số token đã dùng để nghĩ — nhìn con số đó rồi quyết định.
#
# Nhận: minimal | low | medium | high
# Để TRỐNG = không gửi tham số, OpenAI tự quyết (hiện là medium).
#
# Bài viết đi theo khung rất chi tiết trong prompt nên nhiều khả năng không cần
# nghĩ nhiều. Hạ xuống 'low' rồi viết thử 1 bài, bấm Kiểm tra SEO so điểm với
# bài cũ — nhanh hơn mà điểm không tụt thì giữ luôn.
# Dễ nhất là chỉnh bằng ô "Mức suy nghĩ" trong màn hình Cấu hình AI.
REASONING_EFFORT=
